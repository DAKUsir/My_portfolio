# Resend API key. Keep the real value in .env.local or your deployment secret store.
RESEND_API_KEY=

# Local development sender. Resend may restrict this sender to verified recipients.
# For production, replace it with an address on a domain verified in Resend.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Inbox that receives portfolio contact messages.
CONTACT_TO_EMAIL=you@example.com
